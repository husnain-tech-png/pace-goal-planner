# Public Supabase settings (safe in browser because database tables use RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only key for AI plan generation. Never prefix this value with NEXT_PUBLIC_.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini

# AI Coach Chatbot — provider-agnostic (Grok / Groq / OpenAI compatible)
# Falls back to OPENAI_API_KEY if AI_API_KEY is not set.
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-3-mini
